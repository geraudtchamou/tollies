# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/community_events
MONGODB_URL=mongodb://mongo:mongo@localhost:27017/community_media?authSource=admin
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Twilio OTP Configuration
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Firebase Configuration (for push notifications)
FIREBASE_CREDENTIALS=path/to/firebase_credentials.json
FIREBASE_PROJECT_ID=your-project-id

# OpenAI Configuration (for AI categorization)
OPENAI_API_KEY=sk-your-openai-api-key

# Mapbox Configuration (for maps)
MAPBOX_TOKEN=pk.your-mapbox-token

# Application Settings
APP_NAME=Community Events Verification
DEBUG=True
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# CORS Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Security
SECRET_KEY_FOR_ENCRYPTION=your-encryption-key-min-32-characters
