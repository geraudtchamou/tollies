{
  "name": "Community Safety App",
  "short_name": "SafeZone",
  "description": "Real-time community event verification and safety platform",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#eef2f7",
  "theme_color": "#6366f1",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "categories": ["safety", "social", "utilities"],
  "shortcuts": [
    {
      "name": "Report Event",
      "short_name": "Report",
      "description": "Quickly report a safety event",
      "url": "/report",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "SOS Alert",
      "short_name": "SOS",
      "description": "Send emergency SOS alert",
      "url": "/sos",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "View Map",
      "short_name": "Map",
      "description": "View live event map",
      "url": "/map",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "images",
          "accept": ["image/*"]
        }
      ]
    }
  }
}
